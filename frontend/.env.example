# Base URL of the backend API + Socket.io server.
# In local dev, Vite proxies /api to this; production should point at the deployed API.
VITE_API_URL="http://localhost:5000"

# Google Sign-In — same OAuth 2.0 Client ID as GOOGLE_CLIENT_ID in Newbackend/.env.
# Public value (ships in the browser bundle). Never put the client secret here.
# Blank = the Google buttons render disabled.
VITE_GOOGLE_CLIENT_ID=""
