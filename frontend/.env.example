# Base URL of the backend API + Socket.io server.
# In local dev, Vite proxies /api to this; production should point at the deployed API (e.g. https://api.tirvona.com).
VITE_API_URL="http://localhost:5000"

# Google Sign-In — OAuth 2.0 Client ID (public identifier).
# Never put client secrets in frontend environment files.
VITE_GOOGLE_CLIENT_ID=""

# Optional development flags (disabled by default in production)
VITE_ENABLE_DEV_FIXTURES="false"
