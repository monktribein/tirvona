{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://accounts.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src https://accounts.google.com https://api.razorpay.com https://checkout.razorpay.com; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tirvona.com"
        }
      ],
      "destination": "https://www.tirvona.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/:page(aarti|about|admin|ashram|ashrams|ashram-admin|ashram-owner|blog|booking|books|budget-stays-in-vrindavan|cancellation-policy|careers|circuits|contact|cookie-policy|dashboard|destination|destinations|events|family-stays-in-vrindavan|faq|featured-banner|govt-guidelines|handicrafts|help|live-pooja|local|local-guides|login|marketplace|offers|owner|owner-guide|parking|partner|pilgrimage-circuits|pooja|press|privacy|profile|provider|public|puja-items|refund-policy|register|religious-products|reset-password|restaurants|search|services|shops|staff|stay|stay-admin|stay-owner|stay-policies|stays|stays-in-vrindavan|Stays-near-prem-mandir-vrindavan|stays-near-prem-mandir-vrindavan|stays-near-banke-bihari-vrindavan|stays-near-iskcon-vrindavan|support|temples|temple-owner|terms|transport|travel-guides|video|volunteer)",
      "destination": "/index.html"
    },
    {
      "source": "/:page(aarti|about|admin|ashram|ashrams|ashram-admin|ashram-owner|blog|booking|books|budget-stays-in-vrindavan|cancellation-policy|careers|circuits|contact|cookie-policy|dashboard|destination|destinations|events|family-stays-in-vrindavan|faq|featured-banner|govt-guidelines|handicrafts|help|live-pooja|local|local-guides|login|marketplace|offers|owner|owner-guide|parking|partner|pilgrimage-circuits|pooja|press|privacy|profile|provider|public|puja-items|refund-policy|register|religious-products|reset-password|restaurants|search|services|shops|staff|stay|stay-admin|stay-owner|stay-policies|stays|stays-in-vrindavan|Stays-near-prem-mandir-vrindavan|stays-near-prem-mandir-vrindavan|stays-near-banke-bihari-vrindavan|stays-near-iskcon-vrindavan|support|temples|temple-owner|terms|transport|travel-guides|video|volunteer)/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/c/:slug",
      "destination": "/smart-contact.html"
    },
    {
      "source": "/(.*)",
      "destination": "/smart-contact.html"
    }
  ]
}
