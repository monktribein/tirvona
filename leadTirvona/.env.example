# Copy to .env and adjust for your environment.

# Base URL of the Tirvona backend that serves the Lead Collection module.
# Host only — the app appends /api/lead-collection.
VITE_LEAD_API_URL="http://localhost:5000"

# Google Maps for the supervisor route maps (browser key; restrict it to this app's domain
# and to Maps JavaScript API + Routes API). Leave empty to use OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=""
