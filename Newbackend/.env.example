# ── Server & Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Database & Redis ──────────────────────────────────────────────────────────
# All data lives in Supabase PostgreSQL. Use the Session pooler URI (port 5432).
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/tirvona
SUPABASE_POOL_MAX=10
# Optional: connection used by `npm run db:migrate` / `db:verify` only. Set it to
# Supabase's Direct connection (db.<project-ref>.supabase.co:5432) so deploys do
# not compete with the running API for the Session pooler's limited client slots.
# SUPABASE_MIGRATION_URL=
SUPABASE_TTL_SWEEP=true
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=tirvona

# ── Authentication & Security ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-secure-secret-in-production
JWT_EXPIRES_IN=30d
JWT_ISSUER=tirvona-api
JWT_AUDIENCE=tirvona-clients

# ── Razorpay Payments & Webhooks ──────────────────────────────────────────────
# REQUIRED for taking live customer payments and processing automated refunds.
# If missing, payment creation returns a safe blocker response ('RAZORPAY_CREDENTIALS_MISSING')
# and will not fabricate successful payments or duplicate ledger rows.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Communications & WhatsApp ─────────────────────────────────────────────────
# Transactional messaging (Meta Cloud API / MSG91)
# If unconfigured, in-app notifications and WebSocket events still deliver,
# while WhatsApp/SMS delivery will remain unsent without claiming false delivery.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Email Service (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_NAME=Tirvona
EMAIL_FROM_EMAIL=noreply@tirvona.com
EMAIL_REPLY_TO=support@tirvona.com

# ── Cloud Media Storage (Cloudinary) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tirvona

# ── Zoom Live Pooja Integration (Server-to-Server OAuth) ───────────────────────
# REQUIRED for creating and scheduling live Zoom video sessions for online pujas.
# If missing, creating a Zoom session returns a safe blocker response ('ZOOM_NOT_CONFIGURED').
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Provider Module Maintenance ───────────────────────────────────────────────
# Background hold expiration and verification expiry sweeps
PROVIDERS_MAINTENANCE_ENABLED=true

# ── Pandit wallet ─────────────────────────────────────────────────────────────
# Hours a booking payment stays "on hold" before the pandit can withdraw it.
PROVIDER_WALLET_HOLD_HOURS=72
# Tirvona platform fee the devotee pays on top of the pandit's professional fee, in basis
# points (1000 = 10%: ₹501 → ₹551.10). The pandit always receives their full fee. 0 = no fee.
PROVIDER_PLATFORM_FEE_BPS=1000
# Smallest withdrawal in paise (10000 = ₹100).
PROVIDER_MIN_WITHDRAWAL_MINOR=10000
# Pandit (and ashram) bank account numbers are sealed with this key. Required in production
# for bank withdrawals; without it only UPI payouts work. Generate once and never change it
# (existing accounts could no longer be read):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYOUT_ENCRYPTION_KEY=
