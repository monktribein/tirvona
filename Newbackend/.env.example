# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
FRONTEND_URL=http://localhost:5173
# Legacy alias supported when FRONTEND_URL is not set
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true
LOG_LEVEL=info
DNS_SERVERS=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# MongoDB (use a replica set/Atlas URI when transactional flows are enabled)
MONGODB_URI=mongodb://127.0.0.1:27017/tirvona
MONGODB_DB_NAME=tirvona
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Redis and BullMQ
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=tirvona

# Authentication and signed parking QR payloads
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=30d
JWT_ISSUER=tirvona-api
JWT_AUDIENCE=tirvona-clients
PARKING_QR_SECRET=replace-with-an-independent-32-character-secret
ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP policy
OTP_SMS_ENABLED=false
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tirvona

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tirvona <notifications@tirvona.com>"
EMAIL_FROM_NAME=Tirvona
EMAIL_FROM_EMAIL=notifications@tirvona.com
EMAIL_REPLY_TO=support@tirvona.com

# SMS (MSG91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=TRVONA
MSG91_ROUTE=4
MSG91_COUNTRY_CODE=91
