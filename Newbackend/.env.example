# Tirvona backend configuration.
#
# Copy to `Newbackend/.env` and fill in real values. Every variable the server
# reads is listed here; the ones without a default are marked REQUIRED.
# `src/config/environment.ts` validates this file at boot and refuses to start
# on a bad value rather than failing later at request time.
#
# Never commit the filled-in `.env` — it is gitignored. Use a dedicated
# least-privilege database user, and rotate any credential that has ever been
# shared, pasted, or committed.

# ── Runtime ──────────────────────────────────────────────────────────────────
# One of: development | test | production. Anything else fails validation.
NODE_ENV="development"
HOST="0.0.0.0"
PORT="5000"
# Log level for pino. Structured logging is only enabled in production.
LOG_LEVEL="info"
# Optional comma-separated DNS resolvers. Set these if your network's default
# resolver cannot resolve MongoDB Atlas SRV records.
DNS_SERVERS=""

# ── Frontend origin & CORS ───────────────────────────────────────────────────
# Where the SPA is served from. Used for password-reset links and as the CORS
# default. Prefer FRONTEND_URL; CLIENT_URL is a legacy alias kept because the
# Render blueprint still sets it, and is only consulted when FRONTEND_URL is
# unset. Leave it blank unless you are maintaining an older deployment.
FRONTEND_URL="http://localhost:5173"
CLIENT_URL=""
# Comma-separated allowed origins. REQUIRED in production, where a wildcard is
# rejected. Defaults to FRONTEND_URL when unset.
CORS_ORIGINS="http://localhost:5173"
# Enable when running behind a reverse proxy (Render, nginx) so client IPs and
# rate limiting resolve correctly.
TRUST_PROXY="false"
# Serves Swagger UI at /api/docs. Defaults to true outside production; keep it
# off in production.
SWAGGER_ENABLED="true"

# ── Rate limiting ────────────────────────────────────────────────────────────
# Global throttle applied to every route. Auth and upload routes narrow this
# further with their own per-route limits.
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"

# ── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a valid URL. Multi-document transactions are
# used throughout the booking flow, so this must point at a replica set —
# Atlas provides one by default; a standalone local mongod does not.
MONGODB_URI="mongodb://127.0.0.1:27017/tirvona"
MONGODB_DB_NAME="tirvona"
# Only needed when credentials are NOT embedded in MONGODB_URI. Must be set
# together or not at all.
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_MIN_POOL_SIZE="1"
MONGODB_MAX_POOL_SIZE="20"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="10000"
MONGODB_SOCKET_TIMEOUT_MS="45000"

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Backs the BullMQ notification queue and the Socket.IO
# adapter that lets real-time events span multiple instances.
REDIS_URL="redis://127.0.0.1:6379"
QUEUE_PREFIX="tirvona"

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters in production; there is no fallback secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="30d"
JWT_ISSUER="tirvona-api"
JWT_AUDIENCE="tirvona-clients"

# ── Signing & encryption ─────────────────────────────────────────────────────
# Signs parking QR codes. REQUIRED in production, minimum 32 characters.
# Falls back to ENCRYPTION_KEY then JWT_SECRET outside production only.
PARKING_QR_SECRET=""
# Encrypts guest government-ID numbers at rest.
ENCRYPTION_KEY=""

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without them. When both
# are blank the booking flow runs in demo mode: no gateway order is created and
# signature verification is skipped, which would confirm bookings for free.
# `rzp_test_…` keys charge nothing; `rzp_live_…` keys move real money.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Verifies server-to-server webhooks. Razorpay retries these when the browser
# callback is lost — a customer closing the tab mid-payment, or a dropped
# network — so without it such a payment is taken but the booking is never
# confirmed. No webhook route is implemented yet; this is read but unused.
RAZORPAY_WEBHOOK_SECRET=""

# ── File storage (Cloudinary) ────────────────────────────────────────────────
# All three must be set together. Uploads fail with a clear 503 when unset —
# there is deliberately no base64 fallback, in any environment.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="tirvona"

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Delivers OTP codes and password-reset links. When blank, codes are generated
# and stored but never sent — usable for local development only.
RESEND_API_KEY=""
# The sender address. Set either RESEND_FROM_EMAIL directly, or the
# EMAIL_FROM_* pair below — one of them is required once RESEND_API_KEY is set.
# The domain must be verified in the Resend dashboard.
RESEND_FROM_EMAIL=""
EMAIL_FROM_NAME="Tirvona"
EMAIL_FROM_EMAIL="noreply@tirvona.com"
EMAIL_REPLY_TO="support@tirvona.com"

# ── SMS OTP (MSG91) ──────────────────────────────────────────────────────────
# MSG91_OTP_TEMPLATE_ID is required once MSG91_AUTH_KEY is set. SMS delivery
# additionally requires OTP_SMS_ENABLED=true.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="TRVONA"
MSG91_ROUTE="4"
MSG91_COUNTRY_CODE="91"

# ── OTP policy ───────────────────────────────────────────────────────────────
OTP_SMS_ENABLED="false"
# Between 1 and 8.
OTP_LENGTH="6"
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="30"

# ── Google Sign-In ───────────────────────────────────────────────────────────
# The client ID must match VITE_GOOGLE_CLIENT_ID in frontend/.env. When blank,
# /api/auth/google rejects requests and the SPA renders the buttons disabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
