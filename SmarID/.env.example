# Tirvona Smart Contact QR — public contact page
#
# Copy to `.env` and adjust. `.env` is gitignored.

# Origin of the Tirvona API. The app appends /api/v1/smart-contact itself, so
# give it the bare origin — with or without a trailing /api, both are handled.
VITE_API_URL=http://localhost:5000

# The API must allow this app's origin, or the browser blocks every request
# with a CORS error. In development that means CORS_ORIGINS in Newbackend/.env
# has to include http://localhost:5175 (the port in vite.config.js).
#
# In production, add the deployed Smart Contact origin to CORS_ORIGINS as well.
