import React from "react";
import ReactDOM from "react-dom/client";
import { BrowserRouter, Routes, Route, Navigate, Link, useLocation } from "react-router-dom";
import { AuthProvider } from "@/contexts/AuthContext";
import { ToastProvider } from "@/contexts/ToastContext";
import { NotificationProvider } from "@/contexts/NotificationContext";
import { PanditDashboardPage } from "./pages/PanditDashboardPage";
import { PanditProfilePage } from "./pages/PanditProfilePage";
import { PanditOfferingsPage } from "./pages/PanditOfferingsPage";
import { PanditVerificationPage } from "./pages/PanditVerificationPage";
import { PanditAvailabilityPage } from "./pages/PanditAvailabilityPage";
import { LayoutDashboard, User, BookOpen, ShieldCheck, Calendar } from "lucide-react";

const NavigationHeader: React.FC = () => {
  const location = useLocation();
  const navLinks = [
    { to: "/provider/dashboard", label: "Dashboard", icon: <LayoutDashboard size={16} /> },
    { to: "/provider/profile", label: "Profile", icon: <User size={16} /> },
    { to: "/provider/offerings", label: "Offerings", icon: <BookOpen size={16} /> },
    { to: "/provider/verification", label: "Verification", icon: <ShieldCheck size={16} /> },
    { to: "/provider/availability", label: "Availability", icon: <Calendar size={16} /> },
  ];

  return (
    <header className="sticky top-0 z-40 bg-white/90 dark:bg-[#0B192C]/90 backdrop-blur-md border-b border-gray-100 dark:border-slate-800">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex items-center justify-between h-16">
          <div className="flex items-center gap-3">
            <span className="text-sm font-black tracking-tight text-[#0A4DA6] uppercase">
              Tirvona
            </span>
            <span className="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-[#0A4DA6] dark:bg-blue-950/40 dark:text-blue-400">
              Pandit Console
            </span>
          </div>
          <nav className="flex items-center gap-1 sm:gap-2">
            {navLinks.map((link) => {
              const active = location.pathname.startsWith(link.to);
              return (
                <Link
                  key={link.to}
                  to={link.to}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold transition ${
                    active
                      ? "bg-[#0A4DA6] text-white shadow-sm"
                      : "text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-800"
                  }`}
                >
                  {link.icon}
                  <span className="hidden sm:inline">{link.label}</span>
                </Link>
              );
            })}
          </nav>
        </div>
      </div>
    </header>
  );
};

export const App: React.FC = () => {
  return (
    <AuthProvider>
      <ToastProvider>
        <NotificationProvider>
          <BrowserRouter>
            <div className="min-h-screen bg-[#F8FAFC] dark:bg-[#070F1E] text-[#0B192C] dark:text-white flex flex-col">
              <NavigationHeader />
              <main className="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
                <Routes>
                  <Route path="/" element={<Navigate to="/provider/dashboard" replace />} />
                  <Route path="/provider/dashboard" element={<PanditDashboardPage />} />
                  <Route path="/provider/profile" element={<PanditProfilePage />} />
                  <Route path="/provider/offerings" element={<PanditOfferingsPage />} />
                  <Route path="/provider/verification" element={<PanditVerificationPage />} />
                  <Route path="/provider/availability" element={<PanditAvailabilityPage />} />
                  <Route path="*" element={<Navigate to="/provider/dashboard" replace />} />
                </Routes>
              </main>
            </div>
          </BrowserRouter>
        </NotificationProvider>
      </ToastProvider>
    </AuthProvider>
  );
};

const rootEl = document.getElementById("root");
if (rootEl) {
  ReactDOM.createRoot(rootEl).render(
    <React.StrictMode>
      <App />
    </React.StrictMode>,
  );
}
