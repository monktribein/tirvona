# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB Atlas) ────────────────────────────
# Never commit the real .env. Use a dedicated DB user with least privilege.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ashray_bharat"

# ── Auth ────────────────────────────────────────────────
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production URLs).
CLIENT_URL="http://localhost:5173"

# ── Cloudinary (file uploads) ───────────────────────────
# Leave blank to disable uploads locally (upload endpoints return 503).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Razorpay (payments) ─────────────────────────────────
# Leave blank to run payments in demo mode (no real gateway).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── OTP policy ──────────────────────────────────────────
# Set to true to deliver registration/login OTPs by SMS (needs MSG91_AUTH_KEY).
# While false, every OTP is emailed instead — the SMS code path stays intact.
OTP_SMS_ENABLED=false
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Google Sign-In ──────────────────────────────────────
# OAuth 2.0 Client ID (Web application) from console.cloud.google.com.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend. Blank = feature disabled.
GOOGLE_CLIENT_ID=""

# ── MSG91 (SMS OTP) ─────────────────────────────────────
# Leave MSG91_AUTH_KEY blank to run SMS in dev mode: the OTP is logged to the
# server console instead of being sent, and delivery is reported as simulated.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="TRVONA"
MSG91_TEMPLATE_ID=""
MSG91_ROUTE="4"
MSG91_COUNTRY_CODE="91"

# ── Resend (all transactional email) ────────────────────
# Powers OTP codes, password-reset links, notifications and messages.
# API key from https://resend.com/api-keys — leave blank to run email in dev
# mode (the message is logged to the console instead of being sent).
RESEND_API_KEY=""
# EMAIL_FROM_EMAIL must be on a domain verified at https://resend.com/domains,
# or Resend refuses the send. Before verifying a domain, test with
# onboarding@resend.dev — it only delivers to the Resend account owner's address.
EMAIL_FROM_NAME="Tirvona"
EMAIL_FROM_EMAIL="no-reply@tirvona.com"
EMAIL_REPLY_TO="support@tirvona.com"
