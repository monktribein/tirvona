# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB Atlas) ────────────────────────────
# Never commit the real .env. Use a dedicated DB user with least privilege.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ashray_bharat"

# ── Auth ────────────────────────────────────────────────
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production URLs).
CLIENT_URL="http://localhost:5173"

# ── Cloudinary (file uploads) ───────────────────────────
# Leave blank to disable uploads locally (upload endpoints return 503).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Razorpay (payments) ─────────────────────────────────
# Leave blank to run payments in demo mode (no real gateway).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
